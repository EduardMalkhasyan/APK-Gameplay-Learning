+    private static bool ReachesArm64RaiserWithoutConditionalFlow(ApplicationAnalysisContext appContext, ulong address, HashSet<ulong> knownRaisers, int depth, HashSet<ulong> visited)
+    {
+        if (knownRaisers.Contains(address))
+        {
+            return true;
+        }
+        if (depth >= 5 || visited.Add(address) == false)
+        {
+            return false;
+        }
