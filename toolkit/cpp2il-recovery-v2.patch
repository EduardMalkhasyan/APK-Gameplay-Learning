+using Cpp2IL.Core.ISIL;
+using Cpp2IL.Core.Model.Contexts;
+using Cpp2IL.Core.Utils;
+
+namespace Cpp2IL.Core.Analysis;
+
+public static class Arm64Recovery
+{
+    public static void RecoverNativeDetails(MethodAnalysisContext method)
+    {
+        if (method.ControlFlowGraph == null)
+        {
+            return;
+        }
+        var binary = method.AppContext.Binary;
+        uint ReadWord(ulong address)
+        {
+            if (binary.TryMapVirtualAddressToRaw(address, out var raw) == false || raw < 0 || raw + 4 > binary.RawLength)
+            {
+                return 0;
+            }
+            return System.Buffers.Binary.BinaryPrimitives.ReadUInt32LittleEndian(binary.GetRawBinaryContent().Slice((int)raw, 4));
+        }
+        ulong FollowBranch(ulong address)
+        {
+            var visited = new System.Collections.Generic.HashSet<ulong>();
+            for (var depth = 0; depth < 16 && visited.Add(address); depth++)
+            {
+                var word = ReadWord(address);
+                if ((word & 0xFC000000) != 0x14000000)
+                {
+                    return address;
+                }
+                var offset = ((int)(word << 6)) >> 4;
+                address = unchecked(address + (ulong)(long)offset);
+            }
+            return 0;
+        }
+        var export = binary.GetVirtualAddressOfExportedFunctionByName("il2cpp_gc_wbarrier_set_field");
+        ulong barrier = 0;
+        if (export != 0 && ReadWord(export) == 0xAA0103E0 && ReadWord(export + 4) == 0xAA0203E1)
+        {
+            var store = FollowBranch(export + 8);
+            if (store != 0 && ReadWord(store) == 0xF9000001)
+            {
+                barrier = FollowBranch(store + 4);
+            }
+        }
+        foreach (var instruction in method.ControlFlowGraph.Instructions)
+        {
+            if (barrier != 0 && instruction.OpCode == OpCode.Call && instruction.Operands.Count > 0 && instruction.Operands[0] is Immediate target && FollowBranch(target.UnsignedValue) == barrier)
+            {
+                instruction.OpCode = OpCode.Nop;
+                instruction.SetOperands();
+                continue;
+            }
+            TypeAnalysisContext? destinationType = instruction.Destination switch
+            {
+                LocalVariable local => local.Type,
+                FieldReference field => field.Field.FieldType,
+                _ => null
+            };
+            if (destinationType?.FullName is not ("System.Single" or "System.Double"))
+            {
+                continue;
+            }
+            if (instruction.OpCode is not (OpCode.Move or OpCode.Multiply or OpCode.Add or OpCode.Subtract or OpCode.Divide))
+            {
+                continue;
+            }
+            for (var index = 1; index < instruction.Operands.Count; index++)
+            {
+                if (instruction.Operands[index] is not MemoryOperand { Base: null, Index: null, Scale: 0 } memory)
+                {
+                    continue;
+                }
+                var size = destinationType.FullName == "System.Single" ? 4 : 8;
+                var rawBinary = binary.GetRawBinaryContent();
+                var readOnly = false;
+                if (rawBinary.Length >= 64 && rawBinary[0] == 0x7F && rawBinary[1] == 0x45 && rawBinary[2] == 0x4C && rawBinary[3] == 0x46 && rawBinary[4] == 2 && rawBinary[5] == 1)
+                {
+                    var headers = System.Buffers.Binary.BinaryPrimitives.ReadUInt64LittleEndian(rawBinary.Slice(32, 8));
+                    var stride = System.Buffers.Binary.BinaryPrimitives.ReadUInt16LittleEndian(rawBinary.Slice(54, 2));
+                    var count = System.Buffers.Binary.BinaryPrimitives.ReadUInt16LittleEndian(rawBinary.Slice(56, 2));
+                    for (var header = 0; header < count; header++)
+                    {
+                        var offset = headers + (ulong)(header * stride);
+                        if (offset + 56 > (ulong)rawBinary.Length)
+                        {
+                            break;
+                        }
+                        var entry = rawBinary.Slice((int)offset, 56);
+                        var kind = System.Buffers.Binary.BinaryPrimitives.ReadUInt32LittleEndian(entry);
+                        var flags = System.Buffers.Binary.BinaryPrimitives.ReadUInt32LittleEndian(entry.Slice(4));
+                        var start = System.Buffers.Binary.BinaryPrimitives.ReadUInt64LittleEndian(entry.Slice(16));
+                        var length = System.Buffers.Binary.BinaryPrimitives.ReadUInt64LittleEndian(entry.Slice(32));
+                        var address = (ulong)memory.Addend;
+                        if (kind == 1 && (flags & 2) == 0 && address >= start && address + (ulong)size <= start + length)
+                        {
+                            readOnly = true;
+                            break;
+                        }
+                    }
+                }
+                if (readOnly == false)
+                {
+                    continue;
+                }
+                if (binary.TryMapVirtualAddressToRaw((ulong)memory.Addend, out var raw) == false || raw < 0 || raw + size > binary.RawLength)
+                {
+                    continue;
+                }
+                var bytes = binary.GetRawBinaryContent().Slice((int)raw, size);
+                if (size == 4)
+                {
+                    instruction.SetOperand(index, new FloatLiteral(System.BitConverter.Int32BitsToSingle(System.Buffers.Binary.BinaryPrimitives.ReadInt32LittleEndian(bytes))));
+                }
+                else
+                {
+                    instruction.SetOperand(index, new DoubleLiteral(System.BitConverter.Int64BitsToDouble(System.Buffers.Binary.BinaryPrimitives.ReadInt64LittleEndian(bytes))));
+                }
+            }
+        }
+    }
+
+    public static void FoldAggregateCopies(MethodAnalysisContext method)
+    {
+        if (method.ControlFlowGraph == null)
+        {
+            return;
+        }
+        foreach (var block in method.ControlFlowGraph.Blocks)
+        {
+            var instructions = block.Instructions;
+            for (var index = 0; index < instructions.Count; index++)
+            {
+                var instruction = instructions[index];
+                if (instruction.OpCode != OpCode.Move || instruction.Operands.Count != 2 || instruction.Operands[0] is not FieldReference destination || instruction.Operands[1] is not FieldReference source)
+                {
+                    continue;
+                }
+                if (destination.Field.FieldType != source.Local.Type)
+                {
+                    continue;
+                }
+                var fields = Arm64CallingConventionResolver.GetHfaFields(destination.Field.FieldType);
+                if (fields.Length < 2 || source.Field.Name != fields[0].Name || index + fields.Length > instructions.Count)
+                {
+                    continue;
+                }
+                var valid = true;
+                for (var component = 1; component < fields.Length; component++)
+                {
+                    var next = instructions[index + component];
+                    if (next.OpCode != OpCode.Move || next.Operands.Count != 2 || next.Operands[0] is not MemoryOperand memory || memory.Index != null || memory.Scale != 0 || ReferenceEquals(memory.Base, destination.Local) == false || memory.Addend != destination.Offset + fields[component].Offset - fields[0].Offset || next.Operands[1] is not FieldReference fieldSource || ReferenceEquals(fieldSource.Local, source.Local) == false || fieldSource.Field.Name != fields[component].Name)
+                    {
+                        valid = false;
+                        break;
+                    }
+                }
+                if (valid == false)
+                {
+                    continue;
+                }
+                instruction.SetOperand(1, source.Local);
+                for (var component = 1; component < fields.Length; component++)
+                {
+                    instructions[index + component].OpCode = OpCode.Nop;
+                    instructions[index + component].SetOperands();
+                }
+            }
+        }
+    }
+}
